# OpenRouter — free vision models (get key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: shown to OpenRouter for analytics
OPENROUTER_SITE_URL=https://last-wat-optimizer.vercel.app

# Vision models — comma-separated fallback chain (first that works wins)
# Defaults if unset:
#   openrouter/free
#   google/gemma-4-31b-it:free
#   nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_VISION_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free,nex-agi/nex-n2-pro:free,openrouter/free

# Discord feed — bot must be invited to your Last War server
# Create bot: https://discord.com/developers/applications
# Enable "Message Content Intent", invite with Read Messages / View Channels
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_GUILD_ID=your_server_id
DISCORD_CHANNEL_IDS=channel_id_1,channel_id_2
