# OpenRouter — free vision models (get key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: shown to OpenRouter for analytics
OPENROUTER_SITE_URL=https://last-wat-optimizer.vercel.app

# Vision models — comma-separated fallback chain (first that works wins)
# Defaults if unset:
#   openrouter/free
#   google/gemma-4-31b-it:free
#   nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_VISION_MODELS=openrouter/free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
